# ==============================================================================
# PRism Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini / Vertex AI Authentication
# ------------------------------------------------------------------------------
# Set to 'true' if using Google Cloud Vertex AI ADC (via: gcloud auth application-default login)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=prism-demo-project-10492
GOOGLE_CLOUD_LOCATION=us-central1

# Or if using Google AI Studio API Key instead of Vertex AI:
GEMINI_API_KEY=AIzaSyB_SampleDummyKey1234567890abcdefGhIjKlMnOp

# Gemini model selection (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Maximum reasoning turns for autonomous agents
MAX_AGENT_TURNS=25

# ------------------------------------------------------------------------------
# 2. GitHub Target Repository Configuration
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained with 'repo' scope)
GITHUB_TOKEN=github_pat_11DUMMYTOKENabcdef1234567890_XYZ987654321samplePATtokenForPrism
TARGET_REPO_URL=https://github.com/your-org/your-project.git
TARGET_REPO_BRANCH=main
WORKSPACE_DIR=./workspace/project

# ------------------------------------------------------------------------------
# 3. Daily Commit & Vulnerability Digest Agent Settings
# ------------------------------------------------------------------------------
ALERT_EMAIL_TO=developer@example.com
EMAIL_FROM="PRism Security Digest <noreply@prism.dev>"
DIGEST_CRON_SCHEDULE="0 22 * * *"
DIGEST_TIMEZONE="Asia/Kolkata"

# ------------------------------------------------------------------------------
# 4. Email Delivery Provider (SMTP or Resend API)
# ------------------------------------------------------------------------------
# Option A: Standard SMTP (Gmail App Password, SendGrid SMTP, FastMail, Proton Bridge, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-alerts-account@example.com
SMTP_PASS=abcd-efgh-ijkl-mnop
SMTP_SECURE=false

# Option B: Resend API Key (optional modern alternative to SMTP)
RESEND_API_KEY=re_SampleDummyResendKey_987654321abcdef0123456789

