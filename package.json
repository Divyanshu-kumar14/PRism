{
  "name": "prism-agent",
  "version": "0.1.0",
  "description": "Autonomous Codebase Test Coverage & PR Agent powered by Google Gemini and TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "coverage-job": "tsx src/index.ts",
    "interactive": "tsx src/index.ts --interactive",
    "digest": "tsx src/digest_cli.ts",
    "schedule": "tsx src/scheduler.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "google-genai",
    "gemini",
    "agent",
    "tools",
    "vertex-ai",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/adk": "^2.0.0",
    "@google/genai": "^2.20.0",
    "dotenv": "^16.4.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
